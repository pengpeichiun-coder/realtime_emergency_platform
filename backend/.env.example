# Local development only. Replace the role if your PostgreSQL setup uses another.
# This example has no password; configure local PostgreSQL access as appropriate.
DATABASE_URL=postgresql+asyncpg://localhost/emergency_platform
# Optional, separate disposable database used only by integration tests.
# TEST_DATABASE_URL=postgresql+asyncpg://localhost/emergency_platform_test

# Generate a local secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
APP_ENV=development
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Required for webhook configuration; generate with Fernet.generate_key().
WEBHOOK_ENCRYPTION_KEY=
# Development/test only; comma-separated exact origins. Empty rejects loopback.
WEBHOOK_ALLOWED_LOOPBACK_ORIGINS=

# fake is deterministic demo mode; openai requires a real API key.
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
OPENAI_API_KEY=

# Exact browser origins; use HTTPS origins in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
# Forwarded addresses are ignored unless these exact proxy CIDRs are configured.
TRUSTED_PROXY_CIDRS=
ENABLE_HSTS=false

LOG_FORMAT=json
# Required only to scrape the private metrics endpoint. Generate randomly.
METRICS_TOKEN=
