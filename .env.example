# Compose-only environment. Run python3 scripts/init_local_env.py to generate .env.
COMPOSE_PROJECT_NAME=emergency-platform
HTTP_PORT=8080
API2_PORT=8002
# Optional compose.monitoring.yaml profile; all published ports bind loopback.
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
ALERT_RECEIVER_PORT=9095
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
POSTGRES_PASSWORD=
RUNTIME_DATABASE_PASSWORD=
MIGRATION_DATABASE_PASSWORD=
JWT_SECRET=
WEBHOOK_ENCRYPTION_KEY=
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Optional explicit loopback receiver origin for local container tests only.
WEBHOOK_ALLOWED_LOOPBACK_ORIGINS=

LOG_FORMAT=json
# Required only to scrape the private metrics endpoint. Generate randomly.
METRICS_TOKEN=
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Leave empty by default: forwarded headers are ignored unless an exact proxy CIDR
# is configured. Compose Nginx overwrites X-Forwarded-For before proxying.
TRUSTED_PROXY_CIDRS=
ENABLE_HSTS=false
